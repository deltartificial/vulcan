# https://editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
# Four spaces in every language: easier to see at a distance than two.
indent_style = space
indent_size = 4
# A hard limit, checked by `cargo xtask style`.
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

# Git wraps commit messages itself.
[COMMIT_EDITMSG]
max_line_length = unset
